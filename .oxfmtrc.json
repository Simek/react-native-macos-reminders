{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "tabWidth": 2,
  "singleQuote": true,
  "bracketSameLine": true,
  "trailingComma": "es5",
  "arrowParens": "avoid",
  "ignorePatterns": [],
  "sortPackageJson": false,
  "sortTailwindcss": { "functions": ["tw"] },
  "sortImports": {
    "customGroups": [{ "groupName": "ui", "elementNamePattern": ["@ui", "@ui/**"] }],
    "groups": [["side_effect"], ["builtin", "external"], ["internal"], ["parent", "ui"], ["sibling"], ["index"]]
  }
}
